# Example Nangate-style educational mapping. Requires external Liberty via env.
# Invoke with generated script substitution in tests/run_synthesis.py.
read_verilog -sv rtl/alu_4bit.v rtl/control_unit.v rtl/data_memory.v rtl/instruction_memory.v rtl/program_counter.v rtl/register_file.v rtl/cpu_top.v
hierarchy -check -top cpu_top
synth -top cpu_top -flatten -noabc
read_liberty -lib @LIBERTY@
dfflibmap -liberty @LIBERTY@
abc -liberty @LIBERTY@
clean
check -assert
stat -liberty @LIBERTY@
write_verilog -noattr build/synthesis/cpu_top_mapped.v
write_json build/synthesis/cpu_top_mapped.json
